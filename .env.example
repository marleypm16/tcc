# Copie para .env e preencha. O .env não vai para o git.

DATABASE_URL=postgresql+psycopg://lastro:lastro@localhost:5432/lastro
DATABASE_URL_TESTES=postgresql+psycopg://lastro:lastro@localhost:5432/lastro_testes

# GitHub App (webhooks, publicação no PR e login do portal)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.6-flash

WORKER_INTERVALO_CONSULTA_S=5
